! qmmm_md_eq.inp - QM/MM MD (NVT, 300 K, 2 ps) of the reactant, electrostatic embedding, tutorial Section VII
! Needs (in the working directory): amylase_ee.prmtop, forceeval_qmmm.cp2k.inc (copies in system_prep/), QMMM_EM_EE-1.restart, QMMM_EM_EE-RESTART.wfn (from qmmm_em_ee.inp)
! Writes: QMMM_MD_EQ-1.restart(.bin), QMMM_MD_EQ-RESTART.wfn (read by qmmm_md_smd.inp), QMMM_MD_EQ-pos-1.dcd, QMMM_MD_EQ-1.ener
@SET PARM amylase_ee.prmtop
&GLOBAL
  ECHO_INPUT
  PRINT_LEVEL LOW
  PROJECT QMMM_MD_EQ
  RUN_TYPE MD
  SAVE_MEM
&END GLOBAL

&FORCE_EVAL
  METHOD QMMM
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    CHARGE -2
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL
    UKS FALSE
    WFN_RESTART_FILE_NAME QMMM_EM_EE-RESTART.wfn
    &MGRID
      COMMENSURATE  ! mandatory to use GEEP
      CUTOFF 300    ! Default value: 2.80000000E+002
    &END MGRID
    &QS
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1E-6
      MAX_SCF 30
      SCF_GUESS RESTART
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
        SAFE_DIIS TRUE
      &END OT
      &OUTER_SCF
        EPS_SCF 1E-6
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      DENSITY_CUTOFF 1.0E-10
      GRADIENT_CUTOFF 1.0E-10
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &MM
    &FORCEFIELD
      DO_NONBONDED
      EI_SCALE14 0.8333333
      IGNORE_MISSING_CRITICAL_PARAMS FALSE
      PARMTYPE AMBER
      PARM_FILE_NAME $PARM
      SHIFT_CUTOFF TRUE
      VDW_SCALE14 0.5
      &SPLINE
        EMAX_SPLINE 1.0E8
        RCUT_NB [angstrom] 10
      &END SPLINE
    &END FORCEFIELD
    &NEIGHBOR_LISTS
      GEO_CHECK
      NEIGHBOR_LISTS_FROM_SCRATCH
      VERLET_SKIN 1.0
    &END NEIGHBOR_LISTS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
      &EWALD
        ALPHA .40
        EPSILON 1.0E-6
        EWALD_ACCURACY 1.0E-6
        EWALD_TYPE SPME
        GMAX 80
        NS_MAX 11
        O_SPLINE 6
        RCUT 10.0
      &END EWALD
    &END POISSON
  &END MM
  &QMMM
    CENTER EVERY_STEP
    EPS_MM_RSPACE 1.0E-10
    ECOUPL GAUSS
    MM_POTENTIAL_FILE_NAME MM_POTENTIAL
    PARALLEL_SCHEME ATOM
    SPHERICAL_CUTOFF -5.29177209E-001 0.00000000E+000
    USE_GEEP_LIB 6
    @INCLUDE forceeval_qmmm.cp2k.inc
  &END QMMM
  &SUBSYS
    &TOPOLOGY
      AUTOGEN_EXCLUDE_LISTS FALSE
      CONN_FILE_FORMAT AMBER
      CONN_FILE_NAME $PARM
      DISABLE_EXCLUSION_LISTS FALSE
      EXCLUDE_EI 1-3
      EXCLUDE_VDW 1-3
      MOL_CHECK
    &END TOPOLOGY
    &KIND NA+
     ELEMENT Na
    &END KIND
    &KIND CL-
     ELEMENT Cl
    &END KIND
    &KIND C
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZV-GTH-PBE
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NVT
    MAX_STEPS 10000
    STEPS 2000
    STEP_START_VAL 0
    TEMPERATURE 300.0
    TEMP_KIND FALSE
    TIMESTEP 1.
    TIME_START_VAL 0.0
    &THERMOSTAT
      REGION DEFINED
      TYPE CSVR
      &CSVR
        TIMECON 100
      &END CSVR
      &DEFINE_REGION
        MM_SUBSYS ATOMIC
        QM_SUBSYS ATOMIC
      &END DEFINE_REGION
    &END THERMOSTAT
  &END MD
  &PRINT
    &RESTART                                    ! Restart file (PROJECT-1.restart and, split, PROJECT-1.restart.bin)
      &EACH
        MD 100
      &END EACH
      ADD_LAST NUMERIC
      SPLIT_RESTART_FILE TRUE
    &END RESTART
    &RESTART_HISTORY
      &EACH
        MD 500
      &END EACH
      ADD_LAST NUMERIC
    &END RESTART_HISTORY
    &TRAJECTORY                                 ! Controls the output of the trajectory
      &EACH                                     ! How often a frame is written
        MD 5
      &END EACH
      ADD_LAST NUMERIC                          ! Last frame printed at the end of the calculation
      FORMAT DCD                                ! Format of the output trajectory (PROJECT-pos-1.dcd)
    &END TRAJECTORY
  &END PRINT
&END MOTION

&EXT_RESTART
  RESTART_CELL
  RESTART_FILE_NAME QMMM_EM_EE-1.restart
  RESTART_POS
  RESTART_QMMM
  RESTART_COUNTERS FALSE
  RESTART_THERMOSTAT FALSE
&END EXT_RESTART
