! qmmm_em_me.inp - QM/MM minimization with mechanical embedding (PBE/DZVP, GPW), tutorial Section VI
! Needs: amylase.prmtop, forceeval_qmmm.cp2k.inc (from system_prep/), MM_EM-1.restart (from mm_em/)
! Writes: QMMM_EM_ME-1.restart and QMMM_EM_ME-RESTART.wfn (read by qmmm_em_ee.inp), QMMM_EM_ME-pos-1.dcd
@SET PARM amylase.prmtop
&GLOBAL
  ECHO_INPUT
  PRINT_LEVEL LOW
  PROJECT QMMM_EM_ME
  RUN_TYPE GEO_OPT
  SAVE_MEM
&END GLOBAL

&FORCE_EVAL
  METHOD QMMM
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    CHARGE -2
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME POTENTIAL
    UKS FALSE
    &MGRID
      COMMENSURATE  ! mandatory to use GEEP
      CUTOFF 300    ! Default value: 2.80000000E+002
    &END MGRID
    &QS
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1E-6
      MAX_SCF 60
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
        SAFE_DIIS TRUE
      &END OT
      &OUTER_SCF
        EPS_SCF 1E-6
        MAX_SCF 30
      &END OUTER_SCF
    &END SCF
    &XC
      DENSITY_CUTOFF 1.0E-10
      GRADIENT_CUTOFF 1.0E-10
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &MM
    &FORCEFIELD
      DO_NONBONDED
      EI_SCALE14 0.8333333
      IGNORE_MISSING_CRITICAL_PARAMS FALSE
      PARMTYPE AMBER
      PARM_FILE_NAME $PARM
      SHIFT_CUTOFF TRUE
      VDW_SCALE14 0.5
      &SPLINE
        EMAX_SPLINE 1.0E8
        RCUT_NB [angstrom] 10
      &END SPLINE
    &END FORCEFIELD
    &NEIGHBOR_LISTS
      GEO_CHECK
      NEIGHBOR_LISTS_FROM_SCRATCH
      VERLET_SKIN 1.0
    &END NEIGHBOR_LISTS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
      &EWALD
        ALPHA .40
        EPSILON 1.0E-6
        EWALD_ACCURACY 1.0E-6
        EWALD_TYPE SPME
        GMAX 80
        NS_MAX 11
        O_SPLINE 6
        RCUT 10.0
      &END EWALD
    &END POISSON
  &END MM
  &QMMM
    CENTER EVERY_STEP
    ECOUPL NONE
    USE_GEEP_LIB 6
    @INCLUDE forceeval_qmmm.cp2k.inc
  &END QMMM
  &RESCALE_FORCES
    MAX_FORCE 4.21648784E-2
  &END RESCALE_FORCES
  &SUBSYS
    &TOPOLOGY
      AUTOGEN_EXCLUDE_LISTS FALSE
      CONN_FILE_FORMAT AMBER
      CONN_FILE_NAME $PARM
      DISABLE_EXCLUSION_LISTS FALSE
      EXCLUDE_EI 1-3
      EXCLUDE_VDW 1-3
      MOL_CHECK
    &END TOPOLOGY
    &KIND NA+
     ELEMENT Na
    &END KIND
    &KIND CL-
     ELEMENT Cl
    &END KIND
    &KIND C
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-GTH-PBE
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZV-GTH-PBE
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &GEO_OPT
    MAX_DR    6.0E-03 ! Default value: 3.00000000E-003
    MAX_FORCE 1.2E-03 ! Default value: 4.50000000E-004
    MAX_ITER 500
    OPTIMIZER LBFGS
    RMS_DR    3.0E-03 ! Default value: 1.50000000E-003
    RMS_FORCE 9.0E-04 ! Default value: 3.00000000E-004
    TYPE MINIMIZATION
  &END GEO_OPT
  &PRINT
    &TRAJECTORY                                 ! Controls the output of the trajectory
      FORMAT DCD                                ! Format of the output trajectory (PROJECT-pos-1.dcd)
      ADD_LAST NUMERIC                          ! Last frame printed at the end of the calculation
      &EACH                                     ! How often a frame is written
	    GEO_OPT 1
      &END EACH
    &END TRAJECTORY
    &RESTART                                    ! This section controls the printing of restart files
      ADD_LAST NUMERIC
    &END RESTART
    &RESTART_HISTORY
      ADD_LAST NUMERIC
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&EXT_RESTART
  RESTART_CELL
  RESTART_COUNTERS FALSE
  RESTART_FILE_NAME MM_EM-1.restart
  RESTART_POS
&END EXT_RESTART
